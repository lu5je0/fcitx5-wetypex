Backport the json-c 0.18 strict-mode UTF-8 fix:
https://github.com/json-c/json-c/commit/565f181f656439847ef79650caad5c0b6c20171b

Signed char made valid Chinese/emoji bytes look like control characters.
Keep strict JSON and UTF-8 validation enabled in the application.

diff --git a/json_tokener.c b/json_tokener.c
--- a/json_tokener.c
+++ b/json_tokener.c
@@ -644,7 +644,7 @@ struct json_object *json_tokener_parse_ex(struct json_tokener *tok, const char *
-				else if ((tok->flags & JSON_TOKENER_STRICT) && c <= 0x1f)
+				else if ((tok->flags & JSON_TOKENER_STRICT) && (unsigned char)c <= 0x1f)
 				{
 					// Disallow control characters in strict mode
 					tok->err = json_tokener_error_parse_string;
 					goto out;
 				}
 				if (!ADVANCE_CHAR(str, tok) || !PEEK_CHAR(c, tok))
